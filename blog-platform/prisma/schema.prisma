generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          String   @default("registered_user")
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]
  comments      Comment[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  content      String
  publishedAt  DateTime  @default(now())
  readTime     String
  featured     Boolean   @default(false)
  image        String?
  views        Int       @default(0)
  likes        Int       @default(0)
  comments     Int       @default(0)
  authorId     String
  categoryId   String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags         Tag[]
  commentsList Comment[]
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  color       String
  posts       Post[]
}

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  posts  Post[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  authorId  String
  postId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}
