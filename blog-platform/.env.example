# Environment Variables for Northstar Journal

# Local SQLite (default - zero external dependencies):
DATABASE_URL="file:./dev.db"

# Or Production PostgreSQL (Supabase / Neon / AWS RDS / Railway):
# DATABASE_URL="postgresql://username:password@localhost:5432/northstar_journal?schema=public"

# Auth Secrets:
AUTH_SECRET="your-super-secret-auth-key-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
