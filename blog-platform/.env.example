# ==============================================================================
# The Perceptron — Environment Configuration
# ==============================================================================

# Database Connection
# Local development uses SQLite:
DATABASE_URL="file:./dev.db"

# For production on Vercel with PostgreSQL (e.g. Supabase, Neon, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth Session Secret (Generate a strong 32+ character random string)
AUTH_SECRET="your-production-auth-secret-key-replace-me-with-random-string"

# Public Application URL (Update to your Vercel deployment URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# (Optional) Resend Transactional Email API Key for real newsletter emails
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="The Perceptron <onboarding@resend.dev>"
